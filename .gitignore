# .gitignore for Python / PyTorch project (tailored)
# Keeps README.md in repo root; ignores other .md files

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
env.bak/
.env

# PyTorch / model artifacts (do NOT commit large weights)
*.pt
*.pth
*.bin

# Logs
logs/
*.log
wandb/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Jupyter
.ipynb_checkpoints
*.ipynb

# OS files
.DS_Store
Thumbs.db

# Sisyphus working files (hidden control / drafts)
.sisyphus/
.sisyphus*

# Docs and markdown files
docs/
*.md
!/.gitignore
!/README.md
!/.opencode/skills/optimizer-ai-agent/SKILL.md

# Other common Python caches
.mypy_cache/
.pytest_cache/
.cache/
htmlcov/
coverage.xml
coverage/

# local test / build outputs
outputs/
profiler_output/
# local test / build outputs
outputs/
profiler_output/*.json
profiler_output_time/
log_profiler_tb/
tools/vram_profiler/app/snapshot_data.js
!**/.gemini/**/*.json
!**/package.json
!**/tsconfig.json
!tools/**/*.md
tools/vram_profiler/app/snapshot_data.orig.js
*.gz
log_profiler_tb/

# Benchmark outputs
benchmarks/output/
benchmarks/__pycache__/

# Optimizer runtime artifacts
optimizer/artifacts/records/
optimizer/artifacts/benchmarks/
optimizer/artifacts/candidates/
optimizer/artifacts/decisions/
optimizer/artifacts/experiments/
optimizer/artifacts/frontier/
optimizer/artifacts/reports/
optimizer/artifacts/tests/
optimizer/artifacts/worktrees/
optimizer/artifacts/*.json

# Materialized optimizer candidate worktrees
optimizer_worktrees/

# Local optimizer backups
optimizer/backups/
optimizer/reports/
optimizer/run*_cron_iteration*.py
optimizer/run*_cron_iteration*.sh

# Local scratch accidents
=
test_result_v*.json
.opencode/package-lock.json
